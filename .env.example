# Optional AI provider. Leave empty for deterministic-only operation.
TRUSTSHIELD_AI_PROVIDER=
TRUSTSHIELD_AI_MODEL=
TRUSTSHIELD_AI_MODEL_VERSION=unknown
TRUSTSHIELD_AI_TIMEOUT=8

# Set only when TRUSTSHIELD_AI_PROVIDER=gemini. Keep the key server-side.
TRUSTSHIELD_GEMINI_API_KEY=

# Used only when TRUSTSHIELD_AI_PROVIDER=ollama.
TRUSTSHIELD_OLLAMA_URL=http://127.0.0.1:11434

# Local development/admin bootstrap settings.
TRUSTSHIELD_ADMIN_EMAIL=admin@example.com
TRUSTSHIELD_ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-token
TRUSTSHIELD_SECURE_COOKIE=false
