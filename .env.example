# Set this address to grant administrator access when this email registers.
TRUSTSHIELD_ADMIN_EMAIL=admin@example.com
TRUSTSHIELD_ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-one-time-token

# Set to true only when serving behind HTTPS.
TRUSTSHIELD_SECURE_COOKIE=false

# Optional: resource destinations can only be changed while retaining the
# independently verified official host for that resource.
# TRUSTSHIELD_CYBERCRIME_URL=https://cybercrime.gov.in/
# TRUSTSHIELD_CONSUMER_URL=https://consumerhelpline.gov.in/public/
